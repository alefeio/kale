# =========================================================
# APP
# =========================================================

NEXT_PUBLIC_SITE_URL=https://kaeale.vercel.app


# =========================================================
# DATABASE — POSTGRESQL / PRISMA
# =========================================================

# URL utilizada pela aplicação através do Prisma.
# Na Vercel, prefira a connection string apropriada para runtime/serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Conexão direta com o PostgreSQL.
# Utilizada principalmente por Prisma Migrate e operações administrativas.
# Quando o provedor disponibilizar uma URL "direct" ou "non-pooled",
# coloque-a aqui.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"


# =========================================================
# PIX
# =========================================================

# Manter vazia enquanto a chave real não estiver definida.
PIX_KEY=""

# Nome exibido como recebedor.
PIX_RECEIVER_NAME="Karen e Alexandre"

# Cidade do recebedor usada futuramente na geração do BR Code PIX.
PIX_RECEIVER_CITY="BELEM"


# =========================================================
# ADMIN / AUTH — RESERVADO PARA SPRINT FUTURA
# =========================================================

# Gerar uma chave forte somente quando a autenticação for implementada.
AUTH_SECRET=""

# Opcional/futuro.
ADMIN_EMAIL=""
